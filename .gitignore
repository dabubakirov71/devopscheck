# ── Secrets — never commit these ──────────────────────────────────────────────
# Any .env at any depth (root .env, docker/.env, …). Only .env.example is shared.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
credentials.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.whl
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Environments ──────────────────────────────────────────────────────────────
.venv
env/
venv/

# ── Runtime / build output ────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid
*.log
media/
# collectstatic output — regenerated by the entrypoint on every container start
/staticfiles/
# Nginx's alias target for /static/ in prod (docker-compose.prod.yml bind mount)
/staticfiles_data/
*.sqlite3

# Snapshots of the live evaluation set (docs/accuracy/spec.md)
.eval-cache/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Local Claude Code settings ────────────────────────────────────────────────
.claude/settings.local.json
