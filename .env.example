# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Leave this unset for the public web process. The separate admin process sets
# ADMIN_SITE=1 (docker-compose does it for you), which makes it serve /admin/
# and nothing else. Do not set it here — it would take the whole site down to
# an admin login page.
# ADMIN_SITE=0
BASE_URL=https://yourdomain.com
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=devopsaudit
DB_USER=devopsaudit
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at: github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitLab.com OAuth ──────────────────────────────────────────────────────────
# Create at: gitlab.com/-/user_settings/applications
GITLAB_APP_ID=
GITLAB_APP_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI providers (at least one required for AI summaries) ────────────────────
# ── Token encryption (required in production) ────────────────────────────────
# Provider access tokens are encrypted at rest. Generate a dedicated key so that
# rotating SECRET_KEY does not orphan every stored token:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── GitHub App (one-click install, replaces the PAT flow) ────────────────────
# Create at https://github.com/settings/apps
# Permissions: Contents read, Metadata read, Pull requests write, Administration read
# Events: Push, Pull request
# Callback URL: https://yourdomain.com/auth/github/app/callback/
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# ── Public scanner ───────────────────────────────────────────────────────────
# Powers /scan/<owner>/<repo>/ for visitors with no account. Unauthenticated
# GitHub allows 60 requests an hour per IP; a classic token with NO scopes
# raises that to 5000 without granting any access beyond what is already public.
PUBLIC_SCAN_GITHUB_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Payment mode ──────────────────────────────────────────────────────────────
# Values: test | live  (controls Lemon Squeezy sandbox vs live)
PAYMENT_MODE=test

# Shown to buyers on plans that have no self-serve checkout yet.
SUPPORT_EMAIL=support@devopsaudit.app

# ── Lemon Squeezy ─────────────────────────────────────────────────────────────
# Create at: app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_VARIANT_ID=

# One variant per plan and billing period. Create them in the Lemon Squeezy
# dashboard, then paste the variant ids here. LEMONSQUEEZY_VARIANT_ID above is
# the fallback used when a specific variant is not set.
LS_VARIANT_PRO_MONTHLY=
LS_VARIANT_PRO_ANNUAL=
LS_VARIANT_TEAM_MONTHLY=
LS_VARIANT_TEAM_ANNUAL=
LS_VARIANT_COMPLIANCE_MONTHLY=
LS_VARIANT_COMPLIANCE_ANNUAL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Cryptomus (crypto checkout) ───────────────────────────────────────────────
# Sign up at cryptomus.com → Payouts → API
# Use a separate test merchant UUID/key for PAYMENT_MODE=test
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# ── Sentry (optional error tracking) ─────────────────────────────────────────
# Sign up free at sentry.io
SENTRY_DSN=

# ── CSRF (optional override) ──────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Docker DNS (optional) ─────────────────────────────────────────────────────
# Set to your internal DNS server if private GitLab instances are unreachable
DOCKER_DNS_SERVER=
# ── Fix agent (pull request until green CI) ──────────────────────────────────
# Comma-separated owner/repo list the agent may push follow-up commits to,
# or * for all. Empty = off (fix PRs are still opened, just not iterated on).
FIX_AGENT_REPOS=
